params {
    // Overridable with e.g. --max_cpus 8
    max_cpus = 4
}

profiles {
    standard {
        process.executor = 'local'
    }
}

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'ALIGN|MUTECT2_CALLING|GERMLINE_CALLING' {
        cpus = { Math.min(params.max_cpus as int, 4) }
    }
}
