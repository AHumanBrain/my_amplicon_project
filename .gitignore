# Data (Large)
ncbi_data/*
!ncbi_data/.gitkeep
# NOTE: the E. coli reference in common_refs/ is tracked on purpose (examples/CI).
# Other genomes you add there are ignored:
common_refs/*
!common_refs/ecoli_genome.fna
!common_refs/genomic.gff


# Python
__pycache__/
*.py[cod]
*$py.class

# Design Outputs (Ignore transient results)
design/output/
design/*.bed
design/*.csv
design/*.fasta
design/*.txt

# Logs
*.log
*.log.*

# OS
.DS_Store
Thumbs.db
